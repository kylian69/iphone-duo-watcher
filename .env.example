# =============================================================================
#  Surveillance iPhone Duo — secrets et réglages globaux
#  Copier en .env puis remplir. Ne jamais committer le fichier .env.
#  Un canal laissé vide est simplement ignoré (les autres continuent d'envoyer).
# =============================================================================

# --- Telegram : messages (bot API) -------------------------------------------
# Créer le bot avec @BotFather → token. Envoyer un message au bot puis lire
# https://api.telegram.org/bot<TOKEN>/getUpdates → "chat":{"id": ...}
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram : appel vocal via CallMeBot ------------------------------------
# Votre @username Telegram, après avoir autorisé @CallMeBot_txtbot (voir README).
CALLMEBOT_ENABLED=true
CALLMEBOT_TELEGRAM_USER=
# Voix française (liste : https://www.callmebot.com/telegram-call-api/)
CALLMEBOT_LANG=fr-FR-Standard-A
# Au maximum un appel toutes les N minutes ; les alertes simultanées sont groupées
CALLMEBOT_MIN_INTERVAL_MINUTES=5
# Nombre de répétitions du message pendant l'appel
CALLMEBOT_REPEAT=2

# --- Discord (webhook + mention) --------------------------------------------
DISCORD_ENABLED=true
DISCORD_WEBHOOK_URL=
# Votre ID utilisateur Discord (mode développeur → clic droit → Copier l'identifiant)
DISCORD_USER_ID=

# --- Boîte email dédiée aux alertes (IMAP) ----------------------------------
# Laisser vide = connecteur email désactivé automatiquement.
# iCloud : imap.mail.me.com / Gmail : imap.gmail.com / Outlook : outlook.office365.com
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
# Mot de passe d'application (pas le mot de passe du compte)
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_PROCESSED_FOLDER=Traités

# --- Général ------------------------------------------------------------------
POSTAL_CODE=69530
# INFO, ou DEBUG pour afficher l'état complet de chaque site à chaque vérification
LOG_LEVEL=INFO
# Message « toujours actif » toutes les N heures
HEARTBEAT_HOURS=12
TZ=Europe/Paris
